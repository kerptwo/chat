<div class="login-page">
  <h1>Вход</h1>
  <form id="login-form">
    {{!-- Используем компонент input для поля логина --}}
    {{> input id="username" label="Логин" type="text" placeholder="ivanivanov" }}

    {{!-- Используем компонент input для поля пароля --}}
    {{> input id="password" label="Пароль" type="password" placeholder="••••••••••••" }}

    <div class="login-page__button-block">
    {{> button id="button" text="Авторизоваться" }}
    {{> link link="#" textLink="Нет аккаунта?" }}
    </div>
  </form>
</div>